# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone
# (which may be the same zone as RELAY_API_ZONE_NAME).
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=example.com

# Required: Existing Cloudflare Hyperdrive configuration (by name or ID)
# Provisioned via Cloudflare Tunnel + Workers VPC + `wrangler hyperdrive create`
# with `--caching-disabled true` (the relay runs transactional SELECT ... FOR UPDATE
# and read-after-write queries that must not serve stale Hyperdrive query cache).
# The Worker binds this Hyperdrive config by lookup so Alchemy never stores the
# Postgres password in state. On `prod`, RELAY_HYPERDRIVE_NAME defaults to
# `t3code-relay`; non-prod stages default to `t3code-relay-<stage>`.
# Uncomment only if you intentionally want to override the per-stage default.
# RELAY_HYPERDRIVE_NAME=t3code-relay
# RELAY_HYPERDRIVE_ID=

# Required for `pnpm --dir infra/relay db:migrate` (local migrations only, not
# bound into the Worker)
# DATABASE_URL=postgresql://t3code_relay_migrator:...@<host>:5432/t3code_relay?sslmode=verify-ca&sslrootcert=./ca.crt

# Required: GitHub OAuth App (direct OAuth PKCE + Device Flow; replaces Clerk)
# Callback URL: https://relay.<RELAY_API_ZONE_NAME>/v1/auth/github/callback
# Enable Device Flow in the GitHub OAuth App settings. If the allowed org uses
# OAuth App access restrictions, approve this OAuth App for the org (or own it
# under that org) so `/user/memberships/orgs/<org>` returns HTTP 200.
# Note: GITHUB_OAUTH_CLIENT_SECRET also derives the AEAD key sealing stored
# GitHub access tokens; rotating it requires active CLI sessions to log in again.
GITHUB_OAUTH_CLIENT_ID=Ov23li...
GITHUB_OAUTH_CLIENT_SECRET=...
# Comma-separated GitHub org logins allowed to authenticate (fail-closed if empty).
GITHUB_OAUTH_ALLOWED_ORGS=my-org

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off
# Optional: cleanup for tunnels whose host never registered recovery, once they
# have been down for 30 days. Same values, independent of the mode above.
# RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
# Canary stages only: shorten the 30-day legacy grace period, in minutes.
# Ignored on prod.
# RELAY_LEGACY_TUNNEL_GRACE_MINUTES=10

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Apple Push Notification service (required unless APNS_ENABLED=false)
# Set APNS_ENABLED=false when running without Apple push notifications.
APNS_ENABLED=false
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=...
# APNS_KEY_ID=...
# APNS_BUNDLE_ID=...
# APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
